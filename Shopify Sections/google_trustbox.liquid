<style>
    .google-trust-box {
    margin: 16px 0;
    width: 100%;
    }

    .trust-box-link {
    text-decoration: none;
    color: inherit;
    display: block;
    }

    .trust-box-content {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 12px 16px;
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    background-color: #ffffff;
    transition: all 0.2s ease;
