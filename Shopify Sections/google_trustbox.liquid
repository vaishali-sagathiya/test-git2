    background-color: #f9fafb;
    }

    .google-icon {
    flex-shrink: 0;
    margin-top: 2px;
    }

    .rating-content {
    flex-grow: 1;
    }

    .rating-stars {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 4px;
    }

    .rating-number {
    font-weight: 600;
    font-size: 15px;
    color: #111827;
    }

    .stars {
    display: flex;
    gap: 2px;
    }

    .star {
    color: #fbbf24;
    font-size: 14px;
    line-height: 1;
    }

    .star.empty {
    color: #d1d5db;
    }

    .star.partial {
    position: relative;
    color: #fbbf24;
    opacity: 0.5;
    }

    .review-text {
    margin: 0;
    font-size: 14px;
    color: #4b5563;
    line-height: 1.4;
    }

    @media (max-width: 767px) {
    .trust-box-content {
        padding: 10px 14px;
    }
    
    .rating-number {
        font-size: 14px;
    }
    
    .review-text {
        font-size: 13px;
    }
    }
</style>