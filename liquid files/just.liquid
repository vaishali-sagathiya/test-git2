{% comment %} <div class="collection-slider-section">
<div class="page-width">
  <div class="collection-slider swiper">
      <h1>{{ section.settings.headtitle }}</h1>
    <div class="swiper-wrapper">
      {% for block in section.blocks %}
        {% if block.settings.collection != blank %}
          <div class="swiper-slide collection-item">
            <img src="{{ block.settings.image | img_url: 'large' }}" alt="Collection Image">
            <div class="collection-overlay">
              <h3>{{ block.settings.collection.title }}</h3>
              <p>{{ block.settings.caption }}</p>
            <div class="collection-hover-box">
               <h3>{{ block.settings.collection.title }}</h3>
              <p>{{ block.settings.caption }}</p>
              <a href="{{ block.settings.collection.url }}" class="shop-now-btn">Shop Now</a>
            </div>
            </div>
          </div>
        {% endif %}
      {% endfor %}
    </div>
    <div class="swiper-button-prev"> 
         <!-- <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="black">
              <path d="M12 2L15 5H9L12 2ZM12 22L9 19H15L12 22ZM5 12L2 9V15L5 12ZM22 12L19 15V9L22 12ZM16.95 7.05L19.07 4.93L21.19 7.05L19.07 9.17L16.95 7.05ZM7.05 16.95L4.93 19.07L2.81 16.95L4.93 14.83L7.05 16.95ZM16.95 16.95L19.07 19.07L21.19 16.95L19.07 14.83L16.95 16.95ZM7.05 7.05L4.93 4.93L2.81 7.05L4.93 9.17L7.05 7.05Z"/>
          </svg> -->
    </div>
    <div class="swiper-button-next">
        <!-- <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="black">
              <path d="M12 2L15 5H9L12 2ZM12 22L9 19H15L12 22ZM5 12L2 9V15L5 12ZM22 12L19 15V9L22 12ZM16.95 7.05L19.07 4.93L21.19 7.05L19.07 9.17L16.95 7.05ZM7.05 16.95L4.93 19.07L2.81 16.95L4.93 14.83L7.05 16.95ZM16.95 16.95L19.07 19.07L21.19 16.95L19.07 14.83L16.95 16.95ZM7.05 7.05L4.93 4.93L2.81 7.05L4.93 9.17L7.05 7.05Z"/>
          </svg> -->
    </div>
  </div>
</div>
</div> {% endcomment %}

{%- liquid
  assign collection_count = section.settings.collections | size
  assign use_slider = false

  if collection_count > 3
    assign use_slider = true
  endif
-%}

<div class="collection-wrapper color-{{ section.settings.color_scheme }} isolate gradient">
  <div
    class="collection section-{{ section.id }}-padding{% if section.settings.full_width %} collection--full-width{% endif %}"
    id="collection-{{ section.id }}"
    data-id="{{ section.id }}"
  >
    <div class="collection__title title-wrapper title-wrapper--no-top-margin page-width">
      {%- if section.settings.title != blank -%}
        <h2 class="title inline-richtext {{ section.settings.heading_size }}">
          {{ section.settings.title }}
        </h2>
      {%- endif -%}
    </div>

    {%- if use_slider -%}
      <slider-component class="collection-slider .swiper">
    {%- endif -%}

    <ul
      class="grid collection-grid {% if use_slider %}slider{% endif %} grid--{{ section.settings.columns_desktop }}-col-desktop grid--{{ section.settings.columns_mobile }}-col-tablet-down"
      role="list"
    >
      {%- for collection in section.settings.collections -%}
        <li class="grid__item{% if use_slider %} slider__slide{% endif %}">
          <a href="{{ collection.url }}" class="collection-link">
            <div class="collection-image">
              {% if collection.image %}
                <img src="{{ collection.image | img_url: '500x' }}" alt="{{ collection.title | escape }}">
              {% else %}
                <div class="placeholder">No Image</div>
              {% endif %}
            </div>
            <h3 class="collection-title">{{ collection.title }}</h3>
          </a>
        </li>
      {%- endfor -%}
    </ul>

    {%- if use_slider -%}
      </slider-component>
    {%- endif -%}
  </div>
</div>


<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.css">

<script src="https://cdn.jsdelivr.net/npm/swiper@9/swiper-bundle.min.js" defer></script>

<script>
  document.addEventListener("DOMContentLoaded", function () {
    var swiper = new Swiper('.swiper', {
      slidesPerView: 3,
      spaceBetween: 30,
      loop: true, // Ensures continuous sliding
      navigation: {
        nextEl: '.swiper-button-next',
        prevEl: '.swiper-button-prev',
      },
    });
  });
</script>



<style>
.collection-slider {
  position: relative;
}
.collection-item {
  position: relative;
  overflow: hidden;
  color: white;
  transition:  0.5s ease-in-out;
}
.collection-item img {
  width: 100%;
}
.collection-item h3,
.collection-item p{
  color: #fff
}
.collection-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  padding: 10px;
  color: white;
  text-align: center;
  transition:  0.5s ease-in-out;
}
.collection-hover-box {
  opacity: 0;
  height: 0;
}
.collection-item:hover {
  height: auto;
}
.collection-item:hover h3:not(.collection-hover-box h3),
.collection-item:hover p:not(.collection-hover-box p){
  opacity: 0;
}
.collection-item:hover .collection-hover-box {
  opacity: 1;
  height: auto;
}
.swiper-button-prev, .swiper-button-next {
  color: #000;
}
.swiper-wrapper{
  display: flex;
}
 .collection-item .shop-now-btn{
    display: inline-flex;
    background: #fff;
    color: #000;
    padding: 16px 20px;
    margin-bottom: 24px;
 }
 
</style>

{% schema %}
{
  "name": "Collection Slider",
  "settings": [
        {
          "type": "richtext",
          "id": "headtitle",
          "label": "HeadTitle"
        },
       {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 4,
      "label": "t:sections.featured-collection.settings.columns_desktop.label"
    },
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Collection Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        },
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "select",
          "id": "columns_mobile",
          "default": "2",
          "label": "t:sections.featured-collection.settings.columns_mobile.label",
          "options": [
            {
              "value": "1",
              "label": "t:sections.featured-collection.settings.columns_mobile.options__1.label"
            },
            {
              "value": "2",
              "label": "t:sections.featured-collection.settings.columns_mobile.options__2.label"
            }
          ]
    },
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Slider",
      "category": "Custom"
    }
  ]
}
{% endschema %}

